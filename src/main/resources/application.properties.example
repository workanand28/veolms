spring.application.name=veolms
server.port=8080

# Database Configuration
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/veolms}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:your_db_password}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA & Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true

# Flyway Migrations
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.locations=classpath:db/migration

# JWT Signing Secret (256-bit Base64-encoded string)
app.jwt.secret=${JWT_SECRET:your_base64_encoded_256_bit_secret_key}

# Access token lifetime: 15 minutes (in milliseconds)
app.jwt.expiration-ms=900000
